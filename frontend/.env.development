# Variables de entorno del frontend en modo desarrollo (`npm run dev`).
# Solo las que empiezan con VITE_ quedan disponibles en el código (import.meta.env.VITE_...).
# Para cambiar algo SOLO en tu máquina, crea `.env.development.local` (no se sube a Git).

# Prefijo de la API. Vite lo redirige a Flask (ver `server.proxy` en vite.config.js).
VITE_API_URL=/api

# true  → los servicios responden con datos falsos de src/mocks (no necesitas el backend).
# false → los servicios llaman al backend de verdad.
VITE_USE_MOCKS=true
