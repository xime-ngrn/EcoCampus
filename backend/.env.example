# Plantilla de variables del backend.
# Cópiala como `.env` (copy .env.example .env) y llena los valores.
# `.env` NO se sube a Git: contiene la contraseña de la base de datos.

SECRET_KEY=cambia-esta-llave

# Base de datos compartida del equipo (PostgreSQL en Railway).
# Pega aquí el valor de DATABASE_PUBLIC_URL: Railway → servicio Postgres → Variables.
# Usa la URL PÚBLICA (…proxy.rlwy.net:PUERTO). La de DATABASE_URL (…railway.internal)
# solo funciona dentro de Railway.
DATABASE_URL=postgresql://postgres:CONTRASEÑA@HOST.proxy.rlwy.net:PUERTO/railway

# Para trabajar sin internet con una base local en SQLite, usa esta línea en su lugar:
# DATABASE_URL=sqlite:///ecocampus.db

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173
